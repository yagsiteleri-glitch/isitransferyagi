---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import blogPosts from '../data/blogPosts.json';
---

<Layout
  title="Isı Transfer Yağı Fiyatları & Çeşitleri | Toptan Endüstriyel Yağlar"
  description="Shell, Mobil, Castrol, Petrol Ofisi ve Artoil ısı transfer yağı çeşitleri. 320°C yüksek termal kararlılığa sahip termik ısı transfer yağlarında toptan iskonto ve aynı gün stoktan sevkiyat."
>
  <!-- HERO BRAND BANNERS SHOWCASE -->
  <section class="banner-grid-section" aria-label="Markalarımız ve Isı Transfer Yağı Çeşitleri">
    <div class="container">
      <div class="banner-mosaic-showcase">
        <!-- Big Featured Banner: Isı Transfer Yağları (Hero) -->
        <article class="banner-hero-main">
          <a href="#urunler" class="banner-hero-link" aria-label="Isı Transfer Yağlarını İncele">
            <div class="banner-hero-bg">
              <img
                src="/images/banners/hero-artoil.jpg"
                alt="Endüstriyel Isı Transfer Yağları"
                width="720"
                height="420"
                loading="eager"
              />
              <div class="hero-overlay-gradient"></div>
            </div>
            <div class="banner-hero-content">
              <div class="hero-tag-row">
                <span class="hero-brand-pill">
                  <i class="fas fa-shield-alt"></i>
                  <span>Yetkili Satış Noktası</span>
                </span>
                <span class="hero-badge-count">{products.length} Çeşit</span>
              </div>
              <h1 class="hero-banner-title">
                Endüstriyel Termik & Termo
                <span class="hero-highlight">Isı Transfer Yağları</span>
              </h1>
              <p class="hero-banner-desc">
                Kapalı devre endüstriyel tesisatlarda 320°C film sıcaklığına kadar koklaşma ve termal kraking direnci.
              </p>
              <div class="hero-features-list">
                <span><i class="fas fa-check-circle"></i> ISO VG 32</span>
                <span><i class="fas fa-check-circle"></i> Teneke & Varil</span>
                <span><i class="fas fa-check-circle"></i> Stoktan Aynı Gün</span>
              </div>
              <div class="hero-cta-btn">
                <span>Ürünleri İncele</span>
                <i class="fas fa-arrow-right"></i>
              </div>
            </div>
            <div class="hero-product-float">
              <img
                src="/images/banners/artoil-banner.png"
                alt="Isı Transfer Yağı"
                class="hero-float-img"
              />
            </div>
          </a>
        </article>

        <!-- Right 4 Brand Banners Grid (Shell, Mobil, Castrol, Petrol Ofisi) -->
        <div class="banner-mosaic-right">
          <!-- Shell Banner -->
          <article class="brand-banner-card card-shell">
            <a href="/shell" class="brand-card-link" aria-label="Shell Isı Transfer Yağları Sayfasına Git">
              <div class="card-inner-flex">
                <div class="card-text-col">
                  <div class="card-brand-header">
                    <span class="card-brand-name">Shell</span>
                    <span class="card-count-badge">Orijinal</span>
                  </div>
                  <h3 class="card-product-title">Shell Heat Transfer</h3>
                  <p class="card-visc-tag">Heat Transfer Oil S2 Serisi</p>
                  <span class="card-action-link">
                    <span>Ürünleri İncele</span>
                    <i class="fas fa-arrow-right"></i>
                  </span>
                </div>
                <div class="card-img-col">
                  <img
                    src="/images/banners/shell-banner.png"
                    alt="Shell Heat Transfer Oil"
                    class="card-prod-img"
                    loading="lazy"
                  />
                </div>
              </div>
            </a>
          </article>

          <!-- Castrol Banner -->
          <article class="brand-banner-card card-castrol">
            <a href="/castrol" class="brand-card-link" aria-label="Castrol Isı Transfer Yağları Sayfasına Git">
              <div class="card-inner-flex">
                <div class="card-text-col">
                  <div class="card-brand-header">
                    <span class="card-brand-name">Castrol</span>
                    <span class="card-count-badge">Orijinal</span>
                  </div>
                  <h3 class="card-product-title">Castrol Perfecto HT</h3>
                  <p class="card-visc-tag">Perfecto HT 5 Sıvı Mühendisliği</p>
                  <span class="card-action-link">
                    <span>Ürünleri İncele</span>
                    <i class="fas fa-arrow-right"></i>
                  </span>
                </div>
                <div class="card-img-col">
                  <img
                    src="/images/banners/castrol-banner.png"
                    alt="Castrol Perfecto HT 5"
                    class="card-prod-img"
                    loading="lazy"
                  />
                </div>
              </div>
            </a>
          </article>

          <!-- Petrol Ofisi Banner -->
          <article class="brand-banner-card card-po">
            <a href="/petrol-ofisi" class="brand-card-link" aria-label="Petrol Ofisi Isı Transfer Yağları Sayfasına Git">
              <div class="card-inner-flex">
                <div class="card-text-col">
                  <div class="card-brand-header">
                    <span class="card-brand-name">Petrol Ofisi</span>
                    <span class="card-count-badge">Orijinal</span>
                  </div>
                  <h3 class="card-product-title">Petrol Ofisi Isı Transfer</h3>
                  <p class="card-visc-tag">Termo Isı Transfer Yağları</p>
                  <span class="card-action-link">
                    <span>Ürünleri İncele</span>
                    <i class="fas fa-arrow-right"></i>
                  </span>
                </div>
                <div class="card-img-col">
                  <img
                    src="/images/banners/po-banner.png"
                    alt="Petrol Ofisi Isı Transfer Yağı"
                    class="card-prod-img"
                    loading="lazy"
                  />
                </div>
              </div>
            </a>
          </article>

          <!-- Mobil Banner -->
          <article class="brand-banner-card card-mobil">
            <a href="/mobil" class="brand-card-link" aria-label="Mobil Isı Transfer Yağları Sayfasına Git">
              <div class="card-inner-flex">
                <div class="card-text-col">
                  <div class="card-brand-header">
                    <span class="card-brand-name">Mobil</span>
                    <span class="card-count-badge">Orijinal</span>
                  </div>
                  <h3 class="card-product-title">Mobiltherm Serisi</h3>
                  <p class="card-visc-tag">Mobiltherm 605 Yüksek Sıcaklık</p>
                  <span class="card-action-link">
                    <span>Ürünleri İncele</span>
                    <i class="fas fa-arrow-right"></i>
                  </span>
                </div>
                <div class="card-img-col">
                  <img
                    src="/images/banners/mobil-banner.png"
                    alt="Mobiltherm 605"
                    class="card-prod-img"
                    loading="lazy"
                  />
                </div>
              </div>
            </a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ALL PRODUCTS SHOWCASE (Clean Unified Showcase without gaps) -->
  <section id="urunler" class="brand-catalog-section unified-catalog">
    <div class="container">
      <div class="brand-heading-center">
        <span class="brand-kicker-pill">ENDÜSTRİYEL TERMAL YAĞLAR</span>
        <h2 class="section-heading-lg">Öne Çıkan Isı Transfer Yağı Çeşitleri</h2>
        <p class="section-subheading-clean">
          320°C'ye varan yüksek çalışma sıcaklıklarında koklaşma ve oksidasyona dirençli, kapalı devre ısıtma sistemleri için orijinal ambalajlı ürünler.
        </p>
      </div>
      <div class="section-divider-line"></div>

      <!-- Centered balanced responsive cards grid -->
      <div class="product-cards-grid centered-flex-grid">
        {products.map(p => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>

  <!-- SEO CONTENT ARTICLE -->
  <section class="seo-text-section">
    <div class="container">
      <div class="section-divider-line"></div>
      <div class="seo-content-box">
        <h3>Isı Transfer Yağı Nedir?</h3>
        <p>Isı transfer yağı (termik yağ), kapalı ve dolaylı ısıtma tesisatlarında yüksek sıcaklıklarda çalışan sistemlerde ısı enerjisini taşımak üzere geliştirilmiş özel baz yağlar ve antioksidan katkılar içeren sentetik veya mineral yağlardır. Su buharına kıyasla atmosferik basınçta veya çok düşük işletme basınçlarında 300°C - 320°C seviyelerine kadar güvenle çalışabilir.</p>

        <h3>Isı Transfer Yağının Temel Görevleri</h3>
        <p>Tesisat borularında tortu ve karbon oluşumunu (koklaşma) önlemek, kazan serpantinlerinde yüksek termal kararlılık sağlamak ve ısı transfer katsayısını tesisat ömrü boyunca sabit tutmaktır.</p>

        <h3>Doğru Isı Transfer Yağı Seçimi</h3>
        <p>Isı transfer yağı seçiminde maksimum film sıcaklığı, viskozite (genellikle ISO VG 32), parlama noktası ve oksidasyon direnci belirleyici parametrelerdir. Shell Heat Transfer Oil S2, Mobiltherm 605, Castrol Perfecto HT 5, Petrol Ofisi Isı Transfer Yağı ve Artoil Subra serisi endüstriyel tesislerde en çok tercih edilen onaylı ürünlerdir.</p>
      </div>
    </div>
  </section>

  <!-- RECENT BLOG POSTS -->
  <section class="recent-blogs-section">
    <div class="container">
      <div class="brand-heading-center">
        <h2 class="section-heading-lg">Teknik Makaleler ve Rehberler</h2>
      </div>
      <div class="section-divider-line"></div>

      <div class="blog-cards-grid">
        {blogPosts.slice(0, 3).map(post => (
          <article class="blog-card">
            <a href={`/blog/${post.slug}`} class="blog-card-link">
              <div class="blog-card-body">
                <span class="blog-date">{post.date}</span>
                <h3 class="blog-title">{post.title}</h3>
                <p class="blog-excerpt">{post.excerpt}</p>
                <span class="blog-read-more">Devamını Oku &rarr;</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .unified-catalog {
    padding-top: 40px;
    padding-bottom: 60px;
  }
  .brand-kicker-pill {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 999px;
    background: #fff7ed;
    color: #ea580c;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
    border: 1px solid #ffedd5;
  }
  .section-subheading-clean {
    color: #64748b;
    font-size: 15px;
    max-width: 680px;
    margin: 8px auto 0;
    line-height: 1.6;
    text-align: center;
  }
  .centered-flex-grid {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: center !important;
    gap: 24px !important;
    max-width: 1280px;
    margin: 0 auto;
  }
  .centered-flex-grid :global(.product-card) {
    flex: 0 0 280px;
    max-width: 320px;
  }
  @media (max-width: 640px) {
    .centered-flex-grid :global(.product-card) {
      flex: 1 1 100%;
      max-width: 100%;
    }
  }
</style>
